<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- High-Tech Thin Orbital Orbit Ring (Safe Zone Outer Border) -->
    <path
        android:pathData="M 54,54 m -28,0 a 28,28 0 1,1 56,0 a 28,28 0 1,1 -56,0"
        android:strokeColor="#7000FFCC"
        android:strokeWidth="1.2"
        android:strokeLineCap="round" />

    <!-- A thin glowing outer solid ring -->
    <path
        android:pathData="M 54,54 m -32,0 a 32,32 0 1,1 64,0 a 32,32 0 1,1 -64,0"
        android:strokeColor="#30FF007F"
        android:strokeWidth="0.8" />

    <!-- Group rotated at 45 degrees, centered around (54,54) -->
    <group
        android:name="pill_group"
        android:rotation="45"
        android:pivotX="54"
        android:pivotY="54">

        <!-- 1. NEON GLOW CHANNELS (Placed underneath for natural ambient lighting) -->
        <!-- Top Half Glow (Vibrant Magenta) -->
        <path
            android:pathData="M 42,54 L 42,36 A 12,12 0 0,1 66,36 L 66,54 Z"
            android:fillColor="#35FF007F"
            android:strokeColor="#1EFF007F"
            android:strokeWidth="8" />

        <!-- Bottom Half Glow (Vibrant Cyan) -->
        <path
            android:pathData="M 66,54 L 66,72 A 12,12 0 0,1 42,72 L 42,54 Z"
            android:fillColor="#3500FFCC"
            android:strokeColor="#1E00FFCC"
            android:strokeWidth="8" />

        <!-- 2. MAIN SOLID PILL CHASSIS -->
        <!-- Top Half (Neon Magenta) -->
        <path
            android:pathData="M 42,54 L 42,36 A 12,12 0 0,1 66,36 L 66,54 Z"
            android:fillColor="#FFFF007F" />

        <!-- Bottom Half (Neon Cyan) -->
        <path
            android:pathData="M 66,54 L 66,72 A 12,12 0 0,1 42,72 L 42,54 Z"
            android:fillColor="#00FFCC" />

        <!-- 3. DETAILED HUD ELEMENTS & EMBELLISHMENTS -->
        <!-- Center Silver-White Joint Ring -->
        <path
            android:pathData="M 42,54 L 66,54"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="1.8" />

        <!-- High-Tech decorative micro-dots (Medical micro-beads) -->
        <path
            android:pathData="M 54,42 m -2,0 a 2,2 0 1,1 4,0 a 2,2 0 1,1 -4,0"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.8" />

        <path
            android:pathData="M 54,66 m -2,0 a 2,2 0 1,1 4,0 a 2,2 0 1,1 -4,0"
            android:fillColor="#FFFFFF"
            android:fillAlpha="0.8" />

    </group>
</vector>
